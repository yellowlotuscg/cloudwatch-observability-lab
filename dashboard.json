{
  "widgets": [
    {
      "type": "metric", "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Demo request latency (mean milliseconds)",
        "region": "${region}", "view": "timeSeries", "period": 60,
        "stat": "Average",
        "metrics": [["${namespace}", "RequestLatency", "App", "demo"]]
      }
    },
    {
      "type": "metric", "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Demo errors per minute", "region": "${region}",
        "view": "timeSeries", "period": 60, "stat": "Sum",
        "metrics": [["${namespace}", "ErrorCount", "App", "demo"]]
      }
    },
    {
      "type": "alarm", "x": 0, "y": 6, "width": 24, "height": 3,
      "properties": {"title": "Demo alert state", "alarms": ["${alarm_arn}"]}
    }
  ]
}
